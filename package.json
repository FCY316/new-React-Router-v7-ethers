{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "vite preview --outDir build/client",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "start:dev": "react-router dev --mode development",
    "start:test": "react-router dev --mode test",
    "start:pro": "react-router dev --mode production",
    "build:dev": "react-router build --mode development",
    "build:test": "react-router build --mode test",
    "build:pro": "react-router build --mode production"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "ethereum-blockies": "^0.1.1",
    "ethers": "6.17.0",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.14",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-svg": "^16.3.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "vitest": "4.1.11",
    "jsdom": "26.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
